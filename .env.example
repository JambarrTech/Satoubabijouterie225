# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:5173"

# DATABASE_URL: MySQL connection string for Prisma.
DATABASE_URL="mysql://root:@localhost:3306/satouba"

# JWT_SECRET: Secret key used to sign JWT tokens. Must be set in production.
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING"

# PORT: Server port (default: 3000).
# PORT=3000

# LOG_LEVEL: Logging level (default: info). Options: trace, debug, info, warn, error, fatal.
# LOG_LEVEL=info

# SMTP/Email (for production email sending)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
# EMAIL_FROM="noreply@satouba-bijouterie.sn"

# Wave API (for real payment processing)
# Get from https://developer.wave.com
WAVE_API_URL="https://api.wave.com/v1"
WAVE_API_KEY=""
WAVE_MERCHANT_ID=""

# Orange Money API (for real payment processing)
# Get from https://developer.orange.com
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay"
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""

# Africa's Talking SMS (for order notifications, OTP, etc.)
# Get from https://africastalking.com
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID="SaTouba"

# Firebase Admin SDK (for push notifications)
# Generate service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Firebase Client SDK (Frontend)
# Get from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_VAPID_KEY=""  # From Firebase Console > Cloud Messaging > Web configuration

# CORS: comma-separated allowed origins (prod: your domains)
# CORS_ORIGIN="https://satouba-bijouterie.com,https://www.satouba-bijouterie.com"

# Payments — set to true to enable mock payments without real credentials (dev/test)
# In production, set to false and configure real WAVE/ORANGE keys
# PAYMENTS_MOCK="false"

# API URL for webhooks (production should be your domain)
API_URL="http://localhost:3000"
