# ==================================================
# VARIABLES D'ENVIRONNEMENT — SaTouba Bijouterie
# Copier ce fichier en .env et remplir les valeurs
# ==================================================

# Database — PostgreSQL (Neon) ou MySQL (XAMPP local)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT — generer avec: openssl rand -base64 64
JWT_SECRET="VOTRE_SECRET_JDI"

# URLs
APP_URL="https://satoubabijouterie225.vercel.app"
CORS_ORIGIN="https://satoubabijouterie225.vercel.app,https://www.satoubabijouterie225.vercel.app"

# ==================================================
# Africa's Talking SMS
# ==================================================
# 1. Creer un compte sur https://africastalking.com
# 2. Settings > API Key > generer une cle
# 3. SMS > Short Codes > creer "SaTouba"
# 4. Sandbox: AFRICASTALKING_USERNAME="sandbox" (test gratuit)
# 5. Prod: AFRICASTALKING_USERNAME="votre_username" (numeros reels)
# ==================================================
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="atsk_VOTRE_CLE_API_ICI"
AFRICASTALKING_SENDER_ID="SaTouba"

# Localisation
COUNTRY_CODE="225"
CONTACT_PHONE="+225 XX XX XX XX XX"

# Admin seed
ADMIN_PASSWORD="VOTRE_MOT_DE_PASSE_FORT"
GERANT_IDENTIFIER="gerantSatoubaBijouterie6002"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Gemini (optionnel)
GEMINI_API_KEY=""